<?xml version="1.0"?>

<!-- Author: YueLin -->

<robot name="car" xmlns:xacro="http://www.ros.org/wiki/xacro" >

    <xacro:property name="radius" value="$(arg size)" />

    <link name="$(arg name)">
        <visual>
            <origin xyz="0 0 -0.5" rpy="0 0 1.5707963267948966" />
            <geometry>
                <mesh filename="package://simulator/meshes/car.dae" 
                      scale="${radius * 0.2} ${radius * 0.2} ${radius * 0.2}" 
                />
            </geometry>
        </visual>
    </link>

</robot>